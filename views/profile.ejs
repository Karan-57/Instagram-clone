<% include ./partials/header.ejs %>
<div class="w-full min-h-screen bg-black flex justify-center">
    <div class="w-full max-w-lg min-h-screen bg-zinc-900 border-x border-zinc-800/40 text-white pb-24">
        <!-- Top Nav -->
        <div class="nav flex justify-between items-center px-4 py-3 border-b border-zinc-800/40 sticky top-0 bg-zinc-900/95 backdrop-blur-sm z-40">
            <h3 class="text-base font-semibold flex items-center gap-2">
                <i class="ri-lock-line text-xs"></i>
                <%= user.username %>
            </h3>
            <div class="icons flex items-center gap-4">
                <a href="/upload" title="Upload Post" class="hover:text-zinc-300"><i class="text-[1.4rem] ri-add-box-line"></i></a>
                <a href="/logout" title="Log Out" class="hover:text-red-400 text-sm font-medium"><i class="text-[1.4rem] ri-logout-box-r-line"></i></a>
            </div>
        </div>

        <!-- Profile Info -->
        <div class="flex items-center justify-between px-6 mt-6">
            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden border-2 border-zinc-700 shrink-0">
                <img class="w-full h-full object-cover" src="<%= getImageUrl(user.profileImage) %>" alt="">
            </div>
            <div class="stats flex gap-8 sm:gap-10 items-center justify-center">
                <div class="flex flex-col items-center">
                    <span class="font-bold text-base"><%= user.posts ? user.posts.length : 0 %></span>
                    <span class="text-xs text-zinc-400">Posts</span>
                </div>
                <div class="flex flex-col items-center">
                    <span class="font-bold text-base">142</span>
                    <span class="text-xs text-zinc-400">Followers</span>
                </div>
                <div class="flex flex-col items-center">
                    <span class="font-bold text-base">98</span>
                    <span class="text-xs text-zinc-400">Following</span>
                </div>
            </div>
        </div>

        <!-- Name & Bio -->
        <div class="dets px-6 mt-4">
            <h3 class="text-sm font-semibold leading-none"><%= user.name %></h3>
            <% if (user.bio) { %>
                <p class="text-xs text-zinc-300 mt-2 whitespace-pre-line leading-relaxed"><%= user.bio %></p>
            <% } else { %>
                <p class="text-xs text-zinc-500 mt-1 italic">No bio yet.</p>
            <% } %>
        </div>

        <!-- Action Buttons -->
        <div class="px-6 mt-4 flex gap-2">
            <a class="flex-1 py-1.5 bg-zinc-800 hover:bg-zinc-700 transition-colors text-center text-xs font-semibold rounded-lg" href="/edit">Edit Profile</a>
            <a class="flex-1 py-1.5 bg-zinc-800 hover:bg-zinc-700 transition-colors text-center text-xs font-semibold rounded-lg" href="/upload">Share Post</a>
        </div>

        <!-- Grid Divider -->
        <div class="border-t border-zinc-800 mt-6 flex justify-around text-zinc-400">
            <button class="py-2.5 text-white border-b-2 border-white flex items-center justify-center flex-1">
                <i class="ri-grid-fill text-lg"></i>
            </button>
            <button class="py-2.5 hover:text-white flex items-center justify-center flex-1">
                <i class="ri-bookmark-line text-lg"></i>
            </button>
        </div>

        <!-- Posts Grid -->
        <div class="grid grid-cols-3 gap-0.5 mt-0.5">
            <% if (!user.posts || user.posts.length === 0) { %>
                <div class="col-span-3 text-center py-16 text-zinc-500">
                    <i class="ri-camera-lens-line text-4xl"></i>
                    <p class="mt-2 text-xs">No photos yet</p>
                </div>
            <% } else { %>
                <% user.posts.forEach(function(post){ %>
                    <div class="relative aspect-square bg-zinc-800 overflow-hidden group">
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" src="<%= getImageUrl(post.picture) %>" alt="">
                        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-4 text-xs font-semibold text-white">
                            <span class="flex items-center gap-1"><i class="ri-heart-fill"></i> <%= post.likes ? post.likes.length : 0 %></span>
                            <span class="flex items-center gap-1"><i class="ri-chat-3-fill"></i> <%= post.comments ? post.comments.length : 0 %></span>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</div>
<% include ./partials/footer.ejs %>