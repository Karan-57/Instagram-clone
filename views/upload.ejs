<% include ./partials/header.ejs %>
<div class="w-full min-h-screen bg-black flex justify-center">
    <div class="w-full max-w-lg min-h-screen bg-zinc-900 border-x border-zinc-800/40 text-white py-5 px-6 pb-24">
        <!-- Top Nav -->
        <div class="flex justify-between items-center pb-4 border-b border-zinc-800/40">
            <a class="text-sm text-zinc-400 hover:text-white flex items-center gap-1" href="/profile">
                <i class="ri-arrow-left-s-line text-lg"></i>
            </a>
            <h2 class="font-semibold text-sm">New Post</h2>
            <a class="text-sm text-zinc-400 hover:text-white" href="/feed">
                <i class="ri-home-line text-lg"></i>
            </a>
        </div>

        <!-- Upload Form -->
        <form id="uploadform" action="/upload" enctype="multipart/form-data" method="post" class="mt-8 flex flex-col items-center">
            <input id="imageinp" hidden type="file" name="image" accept="image/*" required>

            <!-- Image Picker Box -->
            <div id="selectpic" class="cursor-pointer w-full aspect-square max-w-xs rounded-2xl border-2 border-dashed border-zinc-700 hover:border-zinc-500 bg-zinc-800/50 flex flex-col items-center justify-center overflow-hidden transition-colors relative group">
                <div id="placeholder-content" class="flex flex-col items-center gap-2 p-4 text-center">
                    <div class="w-14 h-14 rounded-full bg-zinc-700/60 flex items-center justify-center text-zinc-300 group-hover:scale-110 transition-transform">
                        <i class="text-2xl ri-image-add-line"></i>
                    </div>
                    <span class="text-xs font-semibold text-blue-400 mt-2">Select photo from device</span>
                    <span class="text-[11px] text-zinc-500">JPG, PNG, WebP supported</span>
                </div>
                <img id="image-preview" class="w-full h-full object-cover hidden" alt="Preview">
            </div>

            <!-- Caption Area -->
            <div class="w-full max-w-xs mt-6">
                <label class="block text-xs text-zinc-400 mb-1.5 font-medium">Caption</label>
                <textarea name="caption" rows="3" class="w-full bg-zinc-800 text-sm text-white placeholder-zinc-500 p-3 rounded-xl border border-zinc-700 focus:outline-none focus:border-zinc-500 resize-none" placeholder="Write a caption for your post..."></textarea>
            </div>

            <!-- Submit Button -->
            <button class="w-full max-w-xs mt-4 py-2.5 bg-blue-500 hover:bg-blue-600 active:scale-[0.99] transition-all text-white font-semibold text-sm rounded-xl shadow-lg shadow-blue-500/20" type="submit">
                Share Post
            </button>
        </form>
    </div>
</div>

<script>
    const selectPic = document.querySelector("#selectpic");
    const imageInp = document.querySelector("#imageinp");
    const preview = document.querySelector("#image-preview");
    const placeholder = document.querySelector("#placeholder-content");

    selectPic.addEventListener("click", () => imageInp.click());

    imageInp.addEventListener("change", function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(evt) {
                preview.src = evt.target.result;
                preview.classList.remove("hidden");
                placeholder.classList.add("hidden");
            };
            reader.readAsDataURL(file);
        }
    });
</script>
<% include ./partials/footer.ejs %>