<% include ./partials/header.ejs %>
<div class="w-full min-h-screen bg-black flex justify-center">
    <div class="w-full max-w-lg min-h-screen bg-zinc-900 border-x border-zinc-800/40 text-white py-5 pb-24">
        <!-- Top Nav -->
        <div class="nav flex justify-between items-center px-4 py-3 border-b border-zinc-800/40 sticky top-0 bg-zinc-900/95 backdrop-blur-sm z-40">
            <h3 class="text-base font-semibold">Creator</h3>
            <div class="icons flex gap-4 items-center">
                <a href="/upload"><i class="text-[1.4rem] ri-add-box-line"></i></a>
                <a href="/feed"><i class="text-[1.4rem] ri-home-line"></i></a>
            </div>
        </div>

        <!-- Info -->
        <div class="flex items-center justify-between px-6 mt-6">
            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden border-2 border-zinc-700 shrink-0">
                <img class="w-full h-full object-cover" src="/images/uploads/default.png" alt="">
            </div>
            <div class="stats flex gap-8 sm:gap-10 items-center justify-center">
                <div class="flex flex-col items-center">
                    <span class="font-bold text-base">77</span>
                    <span class="text-xs text-zinc-400">Posts</span>
                </div>
                <div class="flex flex-col items-center">
                    <span class="font-bold text-base">1.2k</span>
                    <span class="text-xs text-zinc-400">Followers</span>
                </div>
                <div class="flex flex-col items-center">
                    <span class="font-bold text-base">340</span>
                    <span class="text-xs text-zinc-400">Following</span>
                </div>
            </div>
        </div>

        <div class="dets px-6 mt-4">
            <h3 class="text-sm font-semibold">Creator Account</h3>
            <p class="text-xs text-zinc-400 mt-1">Digital creator & visual explorer</p>
        </div>

        <div class="px-6 mt-4 flex gap-2">
            <button class="flex-1 py-1.5 bg-blue-500 hover:bg-blue-600 transition-colors text-center text-xs font-semibold rounded-lg">Follow</button>
            <button class="flex-1 py-1.5 bg-zinc-800 hover:bg-zinc-700 transition-colors text-center text-xs font-semibold rounded-lg">Message</button>
        </div>

        <div class="grid grid-cols-3 gap-0.5 mt-8 border-t border-zinc-800 pt-1">
            <div class="aspect-square bg-zinc-800 overflow-hidden">
                <img class="w-full h-full object-cover" src="/images/uploads/default.png" alt="">
            </div>
        </div>
    </div>
</div>
<% include ./partials/footer.ejs %>