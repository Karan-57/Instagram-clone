<% include ./partials/header.ejs %>
<div class="w-full min-h-screen bg-black flex justify-center">
    <div class="w-full max-w-lg min-h-screen bg-zinc-900 border-x border-zinc-800/40 text-white pb-24">
        <!-- Top Nav -->
        <div class="nav flex justify-between items-center px-4 py-3 border-b border-zinc-800/40 sticky top-0 bg-zinc-900/95 backdrop-blur-sm z-40">
            <div class="flex items-center gap-3">
                <a href="javascript:history.back()" class="text-zinc-300 hover:text-white p-1" title="Back">
                    <i class="ri-arrow-left-line text-xl"></i>
                </a>
                <h3 class="text-base font-semibold truncate max-w-[200px]"><%= targetUser.username %></h3>
            </div>
            <div class="icons flex gap-4 items-center">
                <a href="/search" class="text-zinc-400 hover:text-white" title="Search"><i class="text-xl ri-search-line"></i></a>
                <a href="/feed" class="text-zinc-400 hover:text-white" title="Home"><i class="text-xl ri-home-line"></i></a>
            </div>
        </div>

        <!-- Profile Info -->
        <div class="flex items-center justify-between px-6 mt-6">
            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden border-2 border-zinc-700 shrink-0">
                <img class="w-full h-full object-cover" src="<%= getImageUrl(targetUser.profileImage) %>" alt="<%= targetUser.username %>">
            </div>
            <div class="stats flex gap-8 sm:gap-10 items-center justify-center">
                <div class="flex flex-col items-center">
                    <span class="font-bold text-base"><%= targetUser.posts ? targetUser.posts.length : 0 %></span>
                    <span class="text-xs text-zinc-400">Posts</span>
                </div>
                <div class="flex flex-col items-center">
                    <span id="followersCount" class="font-bold text-base"><%= targetUser.followers ? targetUser.followers.length : 0 %></span>
                    <span class="text-xs text-zinc-400">Followers</span>
                </div>
                <div class="flex flex-col items-center">
                    <span id="followingCount" class="font-bold text-base"><%= targetUser.following ? targetUser.following.length : 0 %></span>
                    <span class="text-xs text-zinc-400">Following</span>
                </div>
            </div>
        </div>

        <!-- Name & Bio -->
        <div class="dets px-6 mt-4">
            <h3 class="text-sm font-semibold leading-none"><%= targetUser.name || targetUser.username %></h3>
            <% if (targetUser.bio) { %>
                <p class="text-xs text-zinc-300 mt-2 whitespace-pre-line leading-relaxed"><%= targetUser.bio %></p>
            <% } else { %>
                <p class="text-xs text-zinc-500 mt-1 italic">No bio yet.</p>
            <% } %>
        </div>

        <!-- Action Buttons -->
        <div class="px-6 mt-4 flex gap-2">
            <button id="followBtn"
                    onclick="toggleFollow('<%= targetUser._id %>')"
                    class="flex-1 py-1.5 <%= isFollowing ? 'bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700/60' : 'bg-blue-500 hover:bg-blue-600 text-white' %> transition-colors text-center text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5">
                <span id="followBtnText"><%= isFollowing ? 'Following' : 'Follow' %></span>
            </button>
        </div>

        <!-- Grid Divider -->
        <div class="border-t border-zinc-800 mt-6 flex justify-around text-zinc-400">
            <div class="py-2.5 text-white border-b-2 border-white flex items-center justify-center flex-1">
                <i class="ri-grid-fill text-lg"></i>
            </div>
        </div>

        <!-- Posts Grid -->
        <div class="grid grid-cols-3 gap-0.5 mt-0.5">
            <% if (!targetUser.posts || targetUser.posts.length === 0) { %>
                <div class="col-span-3 text-center py-16 text-zinc-500">
                    <i class="ri-camera-line text-4xl"></i>
                    <p class="mt-2 text-xs">No posts yet</p>
                </div>
            <% } else { %>
                <% [...targetUser.posts].reverse().forEach(function(post) { %>
                    <div class="aspect-square bg-zinc-800 overflow-hidden relative group">
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" src="<%= getImageUrl(post.picture) %>" alt="Post">
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</div>

<script>
    let isRequesting = false;

    async function toggleFollow(userId) {
        if (isRequesting) return;
        isRequesting = true;

        const btn = document.getElementById('followBtn');
        const btnText = document.getElementById('followBtnText');
        const countSpan = document.getElementById('followersCount');

        try {
            const res = await fetch(`/follow/${userId}`, {
                method: 'POST',
                headers: {
                    'Accept': 'application/json'
                }
            });

            if (res.ok) {
                const data = await res.json();
                if (data.success) {
                    countSpan.textContent = data.followersCount;

                    if (data.isFollowing) {
                        btnText.textContent = 'Following';
                        btn.className = 'flex-1 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700/60 transition-colors text-center text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5';
                    } else {
                        btnText.textContent = 'Follow';
                        btn.className = 'flex-1 py-1.5 bg-blue-500 hover:bg-blue-600 text-white transition-colors text-center text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5';
                    }
                }
            } else {
                console.error('Follow failed with status:', res.status);
            }
        } catch (err) {
            console.error('Follow toggle error:', err);
        } finally {
            isRequesting = false;
        }
    }
</script>

<% include ./partials/footer.ejs %>