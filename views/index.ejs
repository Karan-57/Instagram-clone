<% include ./partials/header.ejs %>
<div class="w-full min-h-screen bg-black flex items-center justify-center p-4">
    <div class="w-full max-w-sm bg-zinc-900 border border-zinc-800 rounded-2xl p-8 flex flex-col items-center shadow-2xl">
        <img class="w-36 mb-6" src="/images/logo.png" alt="Instagram">
        
        <form class="w-full space-y-3" action="/register" method="post">
            <input class="w-full px-3.5 py-2.5 border border-zinc-700/80 rounded-xl text-sm bg-zinc-800 text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-500" type="text" placeholder="Username" name="username" required>
            <input class="w-full px-3.5 py-2.5 border border-zinc-700/80 rounded-xl text-sm bg-zinc-800 text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-500" type="email" placeholder="Email" name="email" required>
            <input class="w-full px-3.5 py-2.5 border border-zinc-700/80 rounded-xl text-sm bg-zinc-800 text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-500" type="text" placeholder="Full Name" name="name" required>
            <input class="w-full px-3.5 py-2.5 border border-zinc-700/80 rounded-xl text-sm bg-zinc-800 text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-500" type="password" placeholder="Password" name="password" required>
            <button class="w-full py-2.5 bg-blue-500 hover:bg-blue-600 active:scale-[0.99] transition-all text-white font-semibold text-sm rounded-xl mt-2 shadow-lg shadow-blue-500/20" type="submit">
                Sign Up
            </button>
        </form>

        <div class="w-full my-6 flex items-center gap-3">
            <div class="flex-1 h-[1px] bg-zinc-800"></div>
            <span class="text-xs text-zinc-500 font-semibold uppercase">or</span>
            <div class="flex-1 h-[1px] bg-zinc-800"></div>
        </div>

        <p class="text-xs text-zinc-400">
            Have an account? <a href="/login" class="text-blue-400 font-semibold hover:underline">Log in</a>
        </p>
    </div>
</div>
<% if (user) { %>
<% include ./partials/footer.ejs %>
<% } %>