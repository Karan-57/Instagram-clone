<% include ./partials/header.ejs %>
<div class="w-full min-h-screen bg-black flex justify-center">
    <div class="w-full max-w-lg min-h-screen bg-zinc-900 border-x border-zinc-800/40 text-white flex flex-col relative pb-24">
        <!-- Top Nav -->
        <div class="px-4 py-3 flex items-center justify-between border-b border-zinc-800/40 sticky top-0 bg-zinc-900/95 backdrop-blur-sm z-40">
            <a href="/feed" class="flex items-center gap-1 text-sm text-zinc-300 hover:text-white">
                <i class="ri-arrow-left-s-line text-lg"></i>
            </a>
            <h2 class="font-semibold text-sm">Comments</h2>
            <div class="w-6"></div>
        </div>

        <!-- Post Caption / OP Header -->
        <% if (post && post.caption) { %>
            <div class="p-4 border-b border-zinc-800/40 flex items-start gap-3 bg-zinc-900/50">
                <div class="w-9 h-9 rounded-full overflow-hidden border border-zinc-700 shrink-0">
                    <img class="w-full h-full object-cover" src="<%= getImageUrl(post.user ? post.user.profileImage : null) %>" alt="">
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-xs">
                        <span class="font-semibold text-white mr-1.5"><%= post.user ? post.user.username : 'user' %></span>
                        <span class="text-zinc-300"><%= post.caption %></span>
                    </p>
                </div>
            </div>
        <% } %>

        <!-- Comments List -->
        <div class="flex-1 overflow-y-auto p-4 space-y-4">
            <% if (post.comments && post.comments.length > 0) { %>
                <% post.comments.forEach((elem) => { %>
                    <div class="flex gap-3 items-start">
                        <!-- Commenter Profile Image -->
                        <div class="w-9 h-9 rounded-full overflow-hidden border border-zinc-700 shrink-0">
                            <img class="w-full h-full object-cover" src="<%= getImageUrl(elem.user ? elem.user.profileImage : null) %>" alt="">
                        </div>

                        <!-- Comment Content -->
                        <div class="flex-1 min-w-0">
                            <div class="flex justify-between items-start gap-2">
                                <div class="text-xs leading-relaxed">
                                    <span class="font-semibold text-white mr-1.5"><%= elem.user ? elem.user.username : 'user' %></span>
                                    <span class="text-zinc-200 break-words"><%= elem.body %></span>
                                </div>
                                <a href="/like/comment/<%= post._id %>/<%= elem._id %>" class="shrink-0 flex items-center gap-1 text-xs text-zinc-400 hover:text-red-500">
                                    <% if (elem.likes && user && elem.likes.some(id => id.toString() === user._id.toString())) { %>
                                        <i class="ri-heart-fill text-red-500"></i>
                                    <% } else { %>
                                        <i class="ri-heart-line"></i>
                                    <% } %>
                                    <span><%= elem.likes ? elem.likes.length : 0 %></span>
                                </a>
                            </div>
                            <div class="mt-1 text-[10px] text-zinc-500">
                                <% 
                                  const now = new Date();
                                  const diff = now - new Date(elem.date);
                                  const secs = Math.floor(diff / 1000);
                                  const mins = Math.floor(secs / 60);
                                  const hrs = Math.floor(mins / 60);
                                  const days = Math.floor(hrs / 24);
                                  let ago = 'now';
                                  if (days > 0) ago = `${days}d`;
                                  else if (hrs > 0) ago = `${hrs}h`;
                                  else if (mins > 0) ago = `${mins}m`;
                                %>
                                <span><%= ago %></span>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="text-center py-16 text-zinc-500">
                    <i class="ri-chat-smile-2-line text-4xl"></i>
                    <p class="mt-2 text-xs">No comments yet.</p>
                    <p class="text-[11px] text-zinc-600">Start the conversation.</p>
                </div>
            <% } %>
        </div>

        <!-- Sticky Comment Input Form -->
        <div class="fixed bottom-12 left-0 right-0 z-40 bg-zinc-900/95 backdrop-blur-md border-t border-zinc-800">
            <div class="max-w-lg mx-auto px-4 py-2 flex items-center gap-3">
                <div class="w-8 h-8 rounded-full overflow-hidden border border-zinc-700 shrink-0">
                    <img class="w-full h-full object-cover" src="<%= getImageUrl(user ? user.profileImage : null) %>" alt="">
                </div>
                <form action="/comments/<%= post._id %>" method="post" class="flex-1 flex items-center gap-2">
                    <input name="body" type="text" required class="flex-1 bg-zinc-800 text-xs text-white placeholder-zinc-500 px-4 py-2.5 rounded-full border border-zinc-700 focus:outline-none focus:border-zinc-500" placeholder="Add a comment for <%= post.user ? post.user.username : 'user' %>...">
                    <button type="submit" class="text-blue-500 font-semibold text-xs px-2 py-1 hover:text-blue-400">Post</button>
                </form>
            </div>
        </div>
    </div>
</div>
<% include ./partials/footer.ejs %>