<% include ./partials/header.ejs %>
<div class="w-full min-h-screen bg-black flex justify-center">
    <div class="w-full max-w-lg min-h-screen bg-zinc-900 border-x border-zinc-800/40 text-white py-5 px-6 pb-24">
        <!-- Top Nav -->
        <div class="flex justify-between items-center pb-4 border-b border-zinc-800/40">
            <a class="text-sm text-zinc-400 hover:text-white flex items-center gap-1" href="/profile">
                <i class="ri-arrow-left-s-line text-lg"></i>
            </a>
            <h2 class="font-semibold text-sm">Edit Profile</h2>
            <a class="text-sm text-zinc-400 hover:text-white" href="/feed">
                <i class="ri-home-line text-lg"></i>
            </a>
        </div>

        <form action="/update" method="post" enctype="multipart/form-data" class="mt-8 flex flex-col items-center">
            <input id="imageinput" hidden type="file" name="image" accept="image/*">

            <!-- Avatar Preview & Edit button -->
            <div class="flex flex-col items-center gap-2">
                <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden border-2 border-zinc-700 relative group cursor-pointer" onclick="document.querySelector('#imageinput').click()">
                    <img id="pfp-preview" class="w-full h-full object-cover" src="<%= getImageUrl(user.profileImage) %>" alt="">
                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-xs">
                        <i class="ri-camera-fill text-lg"></i>
                    </div>
                </div>
                <button type="button" onclick="document.querySelector('#imageinput').click()" class="text-xs font-semibold text-blue-400 hover:text-blue-300">
                    Change profile photo
                </button>
            </div>

            <!-- Profile Form Fields -->
            <div class="w-full max-w-sm mt-8 space-y-4">
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1">Username</label>
                    <input class="w-full px-3.5 py-2.5 bg-zinc-800 border border-zinc-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-zinc-500" type="text" placeholder="Username" name="username" value="<%= user.username %>" required>
                </div>

                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1">Name</label>
                    <input class="w-full px-3.5 py-2.5 bg-zinc-800 border border-zinc-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-zinc-500" type="text" placeholder="Name" name="name" value="<%= user.name %>" required>
                </div>

                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1">Bio</label>
                    <textarea class="w-full px-3.5 py-2.5 bg-zinc-800 border border-zinc-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-zinc-500 resize-none" rows="3" placeholder="Tell people about yourself..." name="bio"><%= user.bio %></textarea>
                </div>

                <button class="w-full mt-6 py-2.5 bg-blue-500 hover:bg-blue-600 active:scale-[0.99] transition-all text-white font-semibold text-sm rounded-xl shadow-lg shadow-blue-500/20" type="submit">
                    Done
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    const imageInput = document.querySelector("#imageinput");
    const pfpPreview = document.querySelector("#pfp-preview");

    imageInput.addEventListener("change", function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(evt) {
                pfpPreview.src = evt.target.result;
            };
            reader.readAsDataURL(file);
        }
    });
</script>
<% include ./partials/footer.ejs %>