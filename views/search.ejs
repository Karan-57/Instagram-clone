<% include ./partials/header.ejs %>
<div class="w-full min-h-screen bg-black flex justify-center">
    <div class="w-full max-w-lg min-h-screen bg-zinc-900 border-x border-zinc-800/40 text-white px-4 py-5 pb-24">
        <!-- Search Input Bar -->
        <div class="bg-zinc-800 border border-zinc-700/60 flex items-center gap-3 px-3.5 py-2.5 rounded-xl sticky top-2 z-30 shadow-sm">
            <i class="text-zinc-400 text-lg ri-search-line"></i>
            <input id="inputusername" class="input w-full bg-transparent outline-none text-sm text-white placeholder-zinc-500" type="text" placeholder="Search users by username...">
        </div>

        <!-- Search Results List -->
        <div class="users divide-y divide-zinc-800/40 mt-3">
            <div id="search-placeholder" class="text-center py-20 text-zinc-500">
                <i class="ri-search-eye-line text-4xl"></i>
                <p class="mt-2 text-xs">Search for creators, friends, and accounts</p>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.11.0/axios.min.js" referrerpolicy="no-referrer"></script>
<script>
    const inp = document.querySelector("#inputusername");
    const usersContainer = document.querySelector(".users");
    const placeholder = document.querySelector("#search-placeholder");

    inp.addEventListener("input", function() {
        const query = inp.value.trim();
        if (!query) {
            usersContainer.innerHTML = `
                <div class="text-center py-20 text-zinc-500">
                    <i class="ri-search-eye-line text-4xl"></i>
                    <p class="mt-2 text-xs">Search for creators, friends, and accounts</p>
                </div>`;
            return;
        }

        axios.get(`/username/${encodeURIComponent(query)}`)
            .then(function(res) {
                let clutter = "";
                if (!res.data || res.data.length === 0) {
                    clutter = `
                        <div class="text-center py-16 text-zinc-500">
                            <p class="text-xs">No accounts found for "${query}"</p>
                        </div>`;
                } else {
                    res.data.forEach((elem) => {
                        const imgSrc = elem.profileImage ? (elem.profileImage.startsWith('http') ? elem.profileImage : `/images/uploads/${elem.profileImage}`) : '/images/uploads/default.png';
                        clutter += `
                            <a href="/profile" class="block py-3 hover:bg-zinc-800/30 px-2 rounded-lg transition-colors">
                                <div class="flex items-center gap-3.5">
                                    <div class="w-11 h-11 rounded-full overflow-hidden border border-zinc-700 shrink-0">
                                        <img class="w-full h-full object-cover" src="${imgSrc}" alt="${elem.username}">
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <h3 class="text-sm font-semibold truncate leading-tight">${elem.username}</h3>
                                        <h4 class="text-xs text-zinc-400 truncate mt-0.5">${elem.name || ''}</h4>
                                    </div>
                                </div>
                            </a>`;
                    });
                }
                usersContainer.innerHTML = clutter;
            })
            .catch(function(err) {
                console.error("Search error:", err);
            });
    });
</script>
<% include ./partials/footer.ejs %>